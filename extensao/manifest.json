{
  "manifest_version": 3,
  "name": "Lino · Tags ServiceNow",
  "version": "0.5.0",
  "minimum_chrome_version": "116",
  "description": "Classifica incidentes do ServiceNow e explora tags nativas em um grafo.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*.service-now.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "painel-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Abrir Lino",
    "default_icon": {
      "16": "assets/icones/lino-16.png",
      "32": "assets/icones/lino-32.png"
    }
  },
  "icons": {
    "16": "assets/icones/lino-16.png",
    "32": "assets/icones/lino-32.png",
    "48": "assets/icones/lino-48.png",
    "128": "assets/icones/lino-128.png"
  },
  "options_page": "opcoes.html",
  "web_accessible_resources": [
    {
      "resources": [
        "painel.html",
        "mascote-contexto.mjs",
        "baloes.mjs",
        "baloes.css",
        "assets/mascote/lino-pet.svg",
        "assets/mascote/mascote-poses.css"
      ],
      "matches": [
        "https://*.service-now.com/*"
      ]
    }
  ]
}
